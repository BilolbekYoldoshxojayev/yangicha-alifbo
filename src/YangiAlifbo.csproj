<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>YangiAlifbo</AssemblyName>
    <RootNamespace>YangiAlifbo</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.1.0</Version>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <Product>YangiAlifbo</Product>
    <Description>O'zbek yozuvi konvertori va jonli muloqot normalizatori</Description>
    <NuGetAudit>false</NuGetAudit>
    <!-- The engine lives in its own projects below this folder. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);YangiAlifbo.Core/**;YangiAlifbo.Native/**</DefaultItemExcludes>
    <!-- Publish: trim unused .NET code (WebView2 kept whole, see TrimRoots.xml).
         Verified with the exe self-test (selftest argument): identical engine output, all checks pass. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);IL3000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="TrimRoots.xml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="UI\Web\**\*" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine and its dictionaries (shared with the Linux build). -->
    <ProjectReference Include="YangiAlifbo.Core\YangiAlifbo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

</Project>
