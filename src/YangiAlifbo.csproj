<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>YangiAlifbo</AssemblyName>
    <RootNamespace>YangiAlifbo</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.9.0</Version>
    <AssemblyVersion>1.9.0.0</AssemblyVersion>
    <FileVersion>1.9.0.0</FileVersion>
    <Product>YangiAlifbo</Product>
    <Description>O'zbek yozuvi konvertori va jonli muloqot normalizatori</Description>
    <NuGetAudit>false</NuGetAudit>
    <!-- Publish: trim unused .NET code (WebView2 kept whole, see TrimRoots.xml).
         Verified with the exe self-test (selftest argument): identical engine output, all checks pass. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);IL3000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="TrimRoots.xml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Core\Dictionaries\uzbek_forms.br" LogicalName="uzbek_forms.br" />
    <EmbeddedResource Include="Core\Dictionaries\english_reject.br" LogicalName="english_reject.br" />
    <EmbeddedResource Include="Core\Dictionaries\foreign_words.br" LogicalName="foreign_words.br" />
    <EmbeddedResource Include="Core\Dictionaries\uzbek_neural.bin.br" LogicalName="uzbek_neural.bin.br" WithCulture="false" />
    <EmbeddedResource Include="UI\Web\**\*" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

</Project>
