    <string name="state_off_text">Samsung yoki Google klaviaturasi bilan ishlaydi. Klaviaturani almashtirish shart emas.</string>
    <string name="state_on_title">Ishlayapti</string>
    <string name="state_on_text">Istalgan ilovada yozing: so‘z probeldan keyin yangi alifboga o‘tadi.</string>
    <string name="state_paused_title">To‘xtatilgan</string>
    <string name="state_paused_text">Avtomatik o‘tkazish o‘chiq. Yoqish uchun tugmani bosing.</string>
